# Copy to server/.env (git-ignored, chmod 600). All optional — fallbacks are labelled in the UI.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash   # tried in order (default shown); GEMINI_TIMEOUT_MS=5000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=       # the user's OWN consented cloned voice only
ELEVENLABS_VOICE_CONSENT=  # must be exactly 'self' to enable the personal voice (verified as a cloned voice at startup)
# Voice substitution and personal-voice pre-generation are USER choices in the UI (set_voice_policy), default off.
# TTS_PRESYNTH=off         # disables all speculative pre-synthesis (system voice included)
# ELEVENLABS_MODEL=eleven_flash_v2_5
TWILIO_AUTH_TOKEN=         # REQUIRED for Twilio once PUBLIC_URL is set (webhook signature verification)
PUBLIC_URL=                # e.g. https://xxxx.trycloudflare.com — only after the user authorizes a tunnel
# Access control (default: tokens generated into data/secrets.json). TACIT_AUTH=off = local dev only, refused with PUBLIC_URL.
# TACIT_USER_TOKEN=
# TACIT_CALLER_TOKEN=
# TACIT_ALLOWED_ORIGINS=https://extra.example
# Persistent turn logging is OFF unless the user opts in from the UI, or the operator sets:
# TACIT_LOG_TURNS=timings   # timings | full (full stores conversation text)
# TACIT_LOG_RETENTION_DAYS=7
# WHISPER_MODEL=models/ggml-base.en.bin
# WHISPER_SERVER=off       # default: spawn + supervise whisper-server on 127.0.0.1:${WHISPER_SERVER_PORT:-8766}
# STT_MIN_RMS=150  STT_HANGOVER_MS=700
# SAY_VOICE=Samantha
# PORT=8790
