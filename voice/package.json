{
  "name": "tacit-voice",
  "version": "0.1.0",
  "private": true,
  "description": "TACIT calling + voice gateway: Twilio Media Streams / browser WebSocket audio <-> ElevenLabs realtime STT + streaming TTS",
  "type": "module",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/dev.ts",
    "dev:fake": "tsx src/dev.ts --fake",
    "dev:tunnel": "tsx src/dev.ts --tunnel",
    "tunnel": "tsx scripts/tunnel.ts",
    "twilio:configure": "tsx scripts/twilio-configure.ts",
    "enroll-voice": "tsx scripts/enroll-voice.ts",
    "check": "tsx scripts/check-providers.ts",
    "fixtures": "tsx test/helpers/make-fixture.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "twilio": "^6.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
