{
  "manifest_version": 3,
  "name": "TACIT Flow \u2014 selected Meet audio",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "User-started, selected-tab audio for the local TACIT Flow candidate. No microphone, captions, page scraping or cloud audio.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:18892/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TACIT Flow capture controls"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:18892;"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      }
    }
  }
}
